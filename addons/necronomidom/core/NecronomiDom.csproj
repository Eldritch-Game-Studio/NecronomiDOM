<Project Sdk="Microsoft.NET.Sdk">
  <!-- Engine-independent HTML/CSS/DOM core: URL policy, DOM, HTML import, CSS syntax/CSSOM, value grammars,
       selectors, cascade, computed values, layout and display lists. Must not reference Godot. -->
  <PropertyGroup>
    <!-- net8.0 / C# 12: the defaults of Godot 4 C# projects and the .NET 8 SDK. -->
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>NecronomiDom</RootNamespace>
    <AssemblyName>NecronomiDom</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- AngleSharp 1.8.4 source with the fragment-context patch in vendor/AngleSharp/patches. -->
    <ProjectReference Include="../vendor/AngleSharp/src/AngleSharp/AngleSharp.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Css/Data/**/*.json;Css/Data/**/*.css" LogicalName="NecronomiDom.%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NecronomiDom.Tests" />
  </ItemGroup>
</Project>
