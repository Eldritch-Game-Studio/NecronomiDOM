+        private void AddFramesetCharacters(ref StructHtmlToken token)
+        {
+            var text = token.Data;
+            var unexpected = false;
+            for (var i = 0; i < text.Length;)
+            {
+                if (text[i].IsSpaceCharacter())
+                {
+                    var start = i++;
+                    while (i < text.Length && text[i].IsSpaceCharacter()) i++;
+                    AddCharacters(new StringOrMemory(text.Memory.Slice(start, i - start)));
+                }
+                else { unexpected = true; i++; }
+            }
+            if (unexpected) RaiseErrorOccurred(HtmlParseError.TokenNotPossible, ref token);
         }
 
