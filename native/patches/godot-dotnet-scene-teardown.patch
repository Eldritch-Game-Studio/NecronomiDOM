-        catch (Exception exception) when (ExceptionHandling.IsHandled(exception)) { }
+            DeinitializeLevel((InitializationLevel)level);
+        }
+        catch (Exception exception) when (ExceptionHandling.IsHandled(exception)) { }
+    }
+
+    // Main-loop shutdown runs after SceneTree.finalize(), but before Main::cleanup flushes
+    // deferred work. Waiting for Scene deinitialization is already too late for that flush.
+    [UnmanagedCallersOnly(CallConvs = [typeof(CallConvCdecl)])]
+    private static void Shutdown_Native()
+    {
+        try
+        {
+            DeinitializeLevel(InitializationLevel.Editor);
+            DeinitializeLevel(InitializationLevel.Scene);
+        }
+        catch (Exception exception) when (ExceptionHandling.IsHandled(exception)) { }
+    }
+
+    private static void DeinitializeLevel(InitializationLevel level)
+    {
+        int levelMask = 1 << (int)level;
+        if ((_initializedLevels & levelMask) == 0)
+        {
+            return;
+        }
+
+        // The engine also sends level-deinitialization callbacks after shutdown, or when
+        // unloading a library. Both paths share ownership and must terminate each level once.
+        _initializedLevels &= ~levelMask;
+        _terminateCallback?.Invoke(level);
+
+        if (level == InitializationLevel.Editor)
+        {
+            GodotRegistry.RemoveAllEditorPlugins();
+        }
+        else if (level == InitializationLevel.Scene)
+        {
+            GodotRegistry.UnregisterAllClasses();
+            DisposablesTracker.DisposeAll();
+        }
+        else if (level == InitializationLevel.Core)
+        {
+            _syncContext?.Dispose();
+            _syncContext = null;
+        }
     }
 
     [UnmanagedCallersOnly(CallConvs = [typeof(CallConvCdecl)])]
