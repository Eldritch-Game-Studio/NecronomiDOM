@@ -146,21 +149,51 @@
     {
         try
         {
-            _terminateCallback?.Invoke((InitializationLevel)level);
-
-            // Only free everything once at the last level.
-            if (level == 0)
-            {
-                _syncContext?.Dispose();
-                _syncContext = null;
-
-                GodotRegistry.RemoveAllEditorPlugins();
-                GodotRegistry.UnregisterAllClasses();
